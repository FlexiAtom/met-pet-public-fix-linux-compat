{
  "name": "dsh-onebot-relay",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "OneBot v11 ↔ DeepSeek Harness 网桥（DSH host 插件）：把 QQ 里的一条消息翻译成一次 DSH agent 会话执行，并把流式输出、最终答复与审批请求推回聊天。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./contract": "./lib/contract.js",
    "./config": "./lib/config.js",
    "./onebot": "./lib/onebot.js",
    "./state": "./lib/state.js",
    "./session-title": "./lib/session-title.js",
    "./rpc/actions": "./lib/rpc/actions.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "self-test": "node scripts/self-test.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:node": "node --test test/",
    "pack": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2 || ^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  }
}
